# Relating - Environment Configuration Template
# Server settings
RELATING_PORT=8080
RELATING_HOST=127.0.0.1
RELATING_DATA_DIR=./data
RELATING_LOG_LEVEL=info

# Metadata storage (SQLite for local, PostgreSQL for server deployments)
RELATING_DATABASE_URL=sqlite://./data/relating_metadata.db

# AI Provider Settings (Optional defaults; project-level configs take precedence)
# AI service is required; fallback to Mock provider if credentials are not configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama / Local inference
OLLAMA_BASE_URL=http://localhost:11434/v1
