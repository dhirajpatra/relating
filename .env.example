# Relating - Environment Configuration Template
# Copy to `.env` and fill in values. Real exported variables always win;
# this file only fills in what is unset. Loaded by start.sh and by the
# server/CLI/MCP binaries themselves (direct `cargo run` works too).

# Server settings
RELATING_PORT=8080
RELATING_HOST=127.0.0.1
RELATING_DATA_DIR=./data
RELATING_LOG_LEVEL=info


# --- LLM routing -------------------------------------------------------------
# meta_api = try Meta API first, fall back to local Ollama on error/timeout.
# Anything else (or unset) = use each project's configured provider.
LLM_BACKEND=meta_api
META_API_KEY=
MODEL_API_KEY=
META_API_URL=https://api.meta.ai/v1/responses
# META_MODEL=muse-ember-1.0
META_MODEL=muse-spark-1.3-contributor
# Seconds to wait for Meta before falling back to Ollama. Keep low for a voice robot.
FALLBACK_TIMEOUT=25
MAX_OUTPUT_TOKENS=1500
# Ollama fallback for Meta chat/embeddings (Meta has no embeddings endpoint,
# so embeddings always use this; chat falls back here on Meta errors):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text
# NOTE: when LLM_BACKEND=meta_api plus a key are set, mock (default)
# projects use Meta automatically. Projects with an explicit non-mock
# provider keep using it; pick provider `meta_api` per project to force Meta.

# Metadata storage (SQLite for local, PostgreSQL for server deployments)
RELATING_DATABASE_URL=sqlite://./data/relating_metadata.db
# Shared PostgreSQL metadata (team deployments): provision with
# `cargo run -p relating-cli --features postgres -- db init-postgres --url <url>`
# and validate with `db check-postgres`. See docs/postgres.md.
# NOTE: the server runs on SQLite; an active postgres URL refuses to start.
# RELATING_DATABASE_URL=postgres://relating@db.internal:5432/relating

# Secret resolution for Aura passwords and other credentials.
# auto (default): $NAME, then $NAME_FILE. Alternatives: env | file | keyring.
# RELATING_SECRET_BACKEND=auto
# Aura password via env var (solo dev) or mounted secret file (team staging):
# AURA_PASSWORD=
# AURA_PASSWORD_FILE=/run/secrets/aura_password
# OS keychain (service 'relating'): `relating secrets set --name AURA_PASSWORD --from-file <path>`
# (rebuild with --features os-keychain, then set RELATING_SECRET_BACKEND=keyring to use it)
# RELATING_SECRET_BACKEND=keyring

# Aura Bolt connection, used automatically when set (no stored connection needed).
# Copy the direct address from the Aura console (never put credentials in it):
# AURA_URI=neo4j+s://xxxxxx.databases.neo4j.io
# AURA_USERNAME=neo4j
# AURA_DATABASE=neo4j
# AURA_NAME=aura (env)
# Aura console API credentials (instance management in the Aura console;
# Relating connects over Bolt, so only AURA_URI + AURA_PASSWORD are used):
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=
AURA_URI=neo4j+s://6325161a.databases.neo4j.io
AURA_USERNAME=
AURA_PASSWORD=
AURA_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# MCP agent transport (optional). stdio works without a token; the HTTP
# transport (POST /mcp) stays disabled until this is set.
# RELATING_MCP_TOKEN=change-me-to-a-long-random-string

# --- Docker Compose (all optional; the compose file has working defaults) ---
# Host-side ports:
POSTGRES_PORT=5432
OLLAMA_PORT=11434
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Team Postgres (used by the `postgres` + `db-init` compose services):
POSTGRES_USER=relating
POSTGRES_PASSWORD=Ch@ngeMeLater
POSTGRES_DB=relating
# Ollama model preload (space-separated; empty skips pulling):
OLLAMA_PRELOAD_MODELS=llama3.1 nomic-embed-text
OLLAMA_NUM_PARALLEL=1
# Optional local Neo4j (`docker compose --profile neo4j up`):
NEO4J_PASSWORD=Ch@ngeMeLater

# --- Reference values for the workbench UI (per-project overrides) ---
# Projects can still pick a provider explicitly in the workbench (project
# settings / AI tab). New projects default to the built-in mock provider
# (offline, deterministic), which routes to Meta automatically when
# LLM_BACKEND=meta_api plus a key are set above. Examples:
#   OpenAI:  base_url=https://api.openai.com/v1  chat=gpt-4o-mini  embeddings=text-embedding-3-small
#   Ollama:  base_url=http://localhost:11434/v1  chat=llama3.1      embeddings=nomic-embed-text
#   Meta:    provider meta_api, base_url=https://api.meta.ai/v1/responses  chat=muse-spark-1.3-contributor
