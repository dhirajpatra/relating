# Relating - Environment Configuration Template
# Server settings
RELATING_PORT=8080
RELATING_HOST=127.0.0.1
RELATING_DATA_DIR=./data
RELATING_LOG_LEVEL=info

# Metadata storage (SQLite for local, PostgreSQL for server deployments)
RELATING_DATABASE_URL=sqlite://./data/relating_metadata.db
# Shared PostgreSQL metadata (team deployments): provision with
# `cargo run -p relating-cli --features postgres -- db init-postgres --url <url>`
# and validate with `db check-postgres`. See docs/postgres.md.
# RELATING_DATABASE_URL=postgres://relating@db.internal:5432/relating

# Secret resolution for Aura passwords and other credentials.
# auto (default): $NAME, then $NAME_FILE. Alternatives: env | file | keyring.
# RELATING_SECRET_BACKEND=auto
# Aura password via env var (solo dev) or mounted secret file (team staging):
# AURA_PASSWORD=
# AURA_PASSWORD_FILE=/run/secrets/aura_password
# OS keychain (service 'relating'): `relating secrets set --name AURA_PASSWORD --from-file <path>`
# RELATING_SECRET_BACKEND=keyring

# MCP agent transport (optional). stdio works without a token; the HTTP
# transport (POST /mcp) stays disabled until this is set.
# RELATING_MCP_TOKEN=change-me-to-a-long-random-string

# --- Docker Compose (all optional; the compose file has working defaults) ---
# Host-side ports:
# RELATING_PORT=8080
# POSTGRES_PORT=5432
# OLLAMA_PORT=11434
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# Team Postgres (used by the `postgres` + `db-init` compose services):
# POSTGRES_USER=relating
# POSTGRES_PASSWORD=change-me-to-a-long-random-string
# POSTGRES_DB=relating
# Ollama model preload (space-separated; empty skips pulling):
# OLLAMA_PRELOAD_MODELS=llama3.1 nomic-embed-text
# OLLAMA_NUM_PARALLEL=1
# Optional local Neo4j (`docker compose --profile neo4j up`):
# NEO4J_PASSWORD=change-me-to-a-long-random-string
# NEO4J_DATABASE=neo4j

# --- Reference values for the workbench UI (NOT read by the server) ---
# AI providers are configured per project in the workbench (project settings /
# AI tab), never from this file. New projects default to the built-in mock
# provider (offline, deterministic). Copy the values below into the UI when a
# project needs real inference:
#   OpenAI:  base_url=https://api.openai.com/v1  chat=gpt-4o-mini  embeddings=text-embedding-3-small
#   Ollama:  base_url=http://localhost:11434/v1  chat=llama3.1      embeddings=nomic-embed-text
